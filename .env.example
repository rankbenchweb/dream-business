# Public production URL. While unset, robots.txt blocks all indexing.
NEXT_PUBLIC_SITE_URL=

# --- Business accounts (sign-in, listings, staff review) -------------------
# Leave both empty to keep accounts switched off. See docs/accounts-setup.md.
# These two are public by design (they go to the browser build).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only secret. Never prefix with NEXT_PUBLIC_ and never share it.
SUPABASE_SERVICE_ROLE_KEY=

# Comma-separated emails of team members who may review listings at /staff/review.
STAFF_EMAILS=

# --- Inquiry storage ----------------------------------------------------------
# Option A: Supabase. Uses SUPABASE_SERVICE_ROLE_KEY above, plus this URL
# (normally the same as NEXT_PUBLIC_SUPABASE_URL). Apply the inquiries migration first.
SUPABASE_URL=

# Option B: any webhook that accepts a JSON POST (for example a public n8n webhook).
INQUIRY_WEBHOOK_URL=
