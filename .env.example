# Public production URL. While unset, robots.txt blocks all indexing.
NEXT_PUBLIC_SITE_URL=

# Inquiry storage (server-only; never prefix with NEXT_PUBLIC_).
# Option A: Supabase. Apply supabase/migrations first.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Option B: any webhook that accepts a JSON POST (for example a public n8n webhook).
INQUIRY_WEBHOOK_URL=
